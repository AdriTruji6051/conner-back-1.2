# ============================================
# CONNER POS - Backend Configuration
# ============================================

# CRITICAL: Generate strong random keys for production
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
# NEVER use default values in production!

# Flask Secret Key (minimum 32 characters)
SECRET_KEY=your-secret-key-here-minimum-32-chars-CHANGE-THIS

# JWT Secret Key (minimum 32 characters)
JWT_SECRET_KEY=your-jwt-secret-key-here-minimum-32-chars-CHANGE-THIS

# ============================================
# Token Expiration Configuration
# ============================================

# Set TOKEN_NEVER_EXPIRES=True for tokens that never expire
# WARNING: This is NOT recommended for production environments!
# Use only for development/testing purposes
# If TOKEN_NEVER_EXPIRES=False, TOKEN_HOURS will be used
TOKEN_NEVER_EXPIRES=False

# Token expiration in hours (only used when TOKEN_NEVER_EXPIRES=False)
TOKEN_HOURS=8

# ============================================
# Database Configuration
# ============================================

# Path to SQLite database file
DB_PATH=./db/conner.db

# ============================================
# Network Configuration
# ============================================

# Host address (0.0.0.0 allows access from local network)
HOST=0.0.0.0

# Port number
PORT=5000

# ============================================
# Application Settings
# ============================================

# Debug mode (MUST be False in production)
DEBUG=False

# Enable logging (recommended True for production)
LOGGING=True

# ============================================
# CORS Configuration
# ============================================

# Allowed origins for CORS
# Default: "*" allows ALL origins (convenient for development)
# WARNING: In production, restrict to specific domains!
# 
# Development (allow all):
# ALLOWED_ORIGINS=*
#
# Development (specific origins):
# ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
#
# Production (restrict to your domains):
# ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
ALLOWED_ORIGINS=*

# ============================================
# Security Notes
# ============================================
# 1. NEVER commit .env file to version control
# 2. Generate unique keys for each environment
# 3. Use HTTPS in production
# 4. Restrict ALLOWED_ORIGINS to your actual domains
# 5. Set DEBUG=False in production
# 6. Regularly rotate SECRET_KEY and JWT_SECRET_KEY
