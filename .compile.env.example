# Conner POS - Compilation Configuration
# Copy this file to .compile.env and adjust as needed

# ============================================
# PROJECT PATHS
# ============================================
# Relative or absolute path to the frontend project
FRONTEND_PATH=../conner-front-1.2

# Backend project path (usually the current directory)
BACKEND_PATH=.

# ============================================
# NETWORK CONFIGURATION
# ============================================
# Backend IP (optional, auto-detected if not specified)
# Uncomment and set manually if auto-detection fails
# BACKEND_IP=192.168.1.100

# Backend port
BACKEND_PORT=5000

# ============================================
# COMPILATION CONFIGURATION
# ============================================
# Angular build configuration (production or development)
ANGULAR_BUILD_CONFIG=production

# Additional PyInstaller options
# --onedir: Generate folder with executable and dependencies
# --windowed: No console window
PYINSTALLER_OPTIONS=--onedir --windowed

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Create database on first startup
DB_CREATE_ON_STARTUP=true

# Database path (relative to executable)
DB_PATH=./db/conner.db

# ============================================
# EXECUTABLE CONFIGURATION
# ============================================
# Final executable name
EXE_NAME=Conner POS

# Executable icon (optional)
# ICON_PATH=icon.ico

# ============================================
# ADVANCED OPTIONS
# ============================================
# Clean temporary files after compilation
CLEAN_TEMP_FILES=true

# Generate detailed logs during compilation
VERBOSE_LOGGING=true

# Compress executable with UPX
USE_UPX=true